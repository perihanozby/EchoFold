func text(key: String) -> String:
	if not ROWS.has(key): return key
	var index = CODES.find(language)
	return ROWS[key].split("|")[maxi(0, index)]

func number(value: int) -> String:
	var result = str(value)
	if language == "ar":
		for i in range(10): result = result.replace(str(i), "٠١٢٣٤٥٦٧٨٩".substr(i, 1))
	return result

func date(value: String) -> String:
	var parts = value.split("-")
	if parts.size() != 3: return value
	var year = number(int(parts[0]))
	var month = number(int(parts[1]))
	var day = number(int(parts[2]))
	if language in ["ja", "ko", "zh_CN"]: return "%s/%s/%s" % [year, month, day]
	if language == "en": return "%s/%s/%s" % [month, day, year]
	return ("%s.%s.%s" if language in ["tr", "de", "ru"] else "%s/%s/%s") % [day, month, year]
